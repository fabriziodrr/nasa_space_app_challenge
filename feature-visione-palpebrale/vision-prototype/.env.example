# Base di pubblicazione: deve iniziare e finire con /.
# Per un sottopercorso, ad esempio: /crewready/vision/
VITE_APP_BASE_PATH=/
VITE_AGENT_ORIGIN=http://localhost:3000

# Percorsi relativi alla base dell'app; / iniziale indica la radice del server.
# Asset locali inclusi in public/models/ (vedi docs/inference.md).
VITE_MODEL_PATH=models/face_landmarker.task
VITE_WASM_PATH=models/wasm/
