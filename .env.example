DATABASE_URL="file:./dev.db"

# T1 local bootstrap. Enable explicitly; forbidden when NODE_ENV=production.
AGENT_DEMO_ENABLED=false
# Set a private token of at least 16 characters before enabling the demo.
# AGENT_DEMO_TOKEN=
# Optional, distinct token for ground-control report access (local demo only).
# AGENT_GROUND_TOKEN=
AGENT_DEMO_SCENARIO=RESTED
AGENT_AI_PROVIDER=mock
# The browser handles speech by default. Optional local NVIDIA Speech NIM services:
AGENT_VOICE_PROVIDER=browser
# AGENT_NIM_ASR_URL=http://127.0.0.1:9000
# AGENT_NIM_TTS_URL=http://127.0.0.1:9001
# For real AI with NVIDIA Developer Program prototyping access, use nvidia.
# Requires a NVIDIA account/API key; access is subject to NVIDIA's current limits.
# NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
AGENT_AI_TIMEOUT_MS=30000
AGENT_CONTEXT_MESSAGE_LIMIT=20
AGENT_VISION_MIN_VALID_MS=30000
AGENT_VISION_MIN_COVERAGE=0.7
AGENT_VISION_MAX_AGE_MINUTES=120
# Optional browser origin of the separately started vision prototype.
NEXT_PUBLIC_VISION_ORIGIN=http://127.0.0.1:5173
AGENT_PREVIOUS_CHECK_IN_LIMIT=3

# Optional paid alternative: AGENT_AI_PROVIDER=openai (never selected as a fallback).
# Choose a model supporting Structured Outputs.
# OPENAI_API_KEY=
# OPENAI_MODEL=
